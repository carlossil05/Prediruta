FROM python:3.10-slim

WORKDIR /app

# Copia los requerimientos e instala las dependencias
COPY api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copia las carpetas api y modelo conservando la estructura de directorios
COPY api/ /app/api/
COPY modelo/ /app/modelo/

# Ejecuta Uvicorn apuntando a la subcarpeta api y al archivo api.py (api.api:app)
CMD ["sh", "-c", "uvicorn api.api:app --host 0.0.0.0 --port ${PORT:-8000}"]