FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.front.txt /app/requirements.front.txt
RUN pip install --no-cache-dir -r requirements.front.txt
COPY front/ /app/front/
CMD ["sh", "-c", "streamlit run front/front_streamlit.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]
