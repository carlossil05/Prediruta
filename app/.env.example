# Copia este archivo como .env y configura la clave solo en tu equipo.
GOOGLE_APIKEY=tu_clave_de_google_maps

# Clave privada que el frontend usa para Places API (New). En local puede ser
# igual a GOOGLE_APIKEY; en producción conviene separarla y limitarla a Places.
GOOGLE_PLACES_APIKEY=tu_clave_de_google_places

# Clave pública para Maps JavaScript y Directions. En producción debe ser
# distinta y estar restringida por los dominios autorizados.
GOOGLE_MAPS_BROWSER_KEY=tu_clave_publica_del_mapa
APP_ENV=local

# El frontend usa esta URL cuando se ejecuta fuera de Docker.
API_URL=http://localhost:8000/predict
